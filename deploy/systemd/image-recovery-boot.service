[Unit]
Description=Restore opted-in IMAGE containers after boot without deployment reset
Requires=docker.service
Wants=image-recovery-events.service
After=docker.service image-recovery-events.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /var/docker/image/IMAGE-server/scripts/image_recovery.py boot
ExecStartPost=/usr/bin/python3 /var/docker/image/IMAGE-server/scripts/image_recovery.py warmup
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target

{
  "name": "orchestrator",
  "version": "0.2.1",
  "description": "Entry point for request handling",
  "main": "dist/server.js",
  "scripts": {
    "prepare-schemas": "if [ -d ../schemas ]; then rm -rf src/schemas && cp -R ../schemas src/; fi",
    "prebuild": "npm run prepare-schemas && eslint --ext .ts src",
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node .",
    "pretest": "npm run prepare-schemas",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/memjs": "^1.3.3",
    "ajv": "^8.20.0",
    "dockerode": "^3.3.5",
    "express": "^4.22.2",
    "memjs": "1.3.2",
    "object-hash": "^2.2.0",
    "sharp": "^0.35.3",
    "uuid": "^11.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.47",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.0",
    "@types/object-hash": "^2.2.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.57.1",
    "supertest": "^7.1.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "tar-fs": "^2.1.2"
  }
}
